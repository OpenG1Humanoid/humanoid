// ---------------------------------------------------------------- printed hardware
module hub_DS3235() {   // print hex-end down. Torque via hex, radial screws hold the child.
  difference() {
    union() {
      translate([0,0,-8.0000]) cylinder(d=25.4034,h=8.6100,$fn=6);
      translate([0,0,0.6000]) cylinder(r=13.1017,h=3.0000);
    }
    translate([0,0,-9.0000]) cylinder(d=3.8000,h=13.6000);                 // horn centre screw (through)
    translate([0,0,-9.0000]) cylinder(d=6.4000,h=7.6000);               // its head sits on a 2 mm floor
    for (a=[45,135,225,315]) rotate([0,0,a]) translate([6.9700,0,-0.4000]) cylinder(d=2.5000,h=5);  // horn screws from the horn side
    translate([0,0,2.6000]) cylinder(d=20.8000,h=2);                      // 1 mm horn locating recess
    for (a=[30:60:330]) rotate([0,0,a]) translate([0,0,-4.5000]) rotate([0,90,0]) cylinder(d=2.5000,h=30);
  }
}
module hub_X10PRO() {   // print hex-end down. Torque via hex, radial screws hold the child.
  difference() {
    union() {
      translate([0,0,-7.0000]) cylinder(d=18.4752,h=7.6100,$fn=6);
      translate([0,0,0.6000]) cylinder(r=9.6376,h=3.0000);
    }
    translate([0,0,-8.0000]) cylinder(d=3.8000,h=12.6000);                 // horn centre screw (through)
    translate([0,0,-8.0000]) cylinder(d=6.4000,h=6.6000);               // its head sits on a 2 mm floor
    for (a=[45,135,225,315]) rotate([0,0,a]) translate([4.9300,0,-0.4000]) cylinder(d=2.5000,h=5);  // horn screws from the horn side
    translate([0,0,2.6000]) cylinder(d=14.8000,h=2);                      // 1 mm horn locating recess
    for (a=[30:60:330]) rotate([0,0,a]) translate([0,0,-4.0000]) rotate([0,90,0]) cylinder(d=2.5000,h=30);
  }
}
module hub_MG92B_wristroll() {   // print hex-end down. Torque via hex, radial screws hold the child.
  difference() {
    union() {
      translate([0,0,-5.0000]) cylinder(d=16.1658,h=5.6100,$fn=6);
      translate([0,0,0.6000]) cylinder(r=8.4829,h=3.0000);
    }
    translate([0,0,-6.0000]) cylinder(d=2.8000,h=10.6000);                 // horn centre screw (through)
    translate([0,0,-6.0000]) cylinder(d=4.6000,h=4.6000);               // its head sits on a 2 mm floor
    for (a=[45,135,225,315]) rotate([0,0,a]) translate([4.2500,0,-0.4000]) cylinder(d=1.7000,h=5);  // horn screws from the horn side
    translate([0,0,2.6000]) cylinder(d=12.8000,h=2);                      // 1 mm horn locating recess
    for (a=[30:60:330]) rotate([0,0,a]) translate([0,0,-3.0000]) rotate([0,90,0]) cylinder(d=1.7000,h=30);
  }
}
module hub_MG92B_cover() {   // goes in from OUTSIDE the cover, then the cap is glued over it
  difference() {
    union() {
      translate([0,0,-7.9000]) cylinder(d=19.9658,h=1.5);
      translate([0,0,-6.4000]) cylinder(d=16.1658,h=10.0000,$fn=6);
    }
    translate([0,0,-9.0000]) cylinder(d=2.4,h=30);                                        // M2 horn screw
    translate([0,0,-9.0000]) cylinder(d=4.2,h=2.2000);
    for (a=[0,180]) rotate([0,0,a]) translate([4,0,-0.4000]) cylinder(d=1.7,h=5);     // horn screws from the horn side
    translate([0,0,2.6000]) cylinder(d=12.8000,h=2);
  }
}
module idler_pin() {   // 5 mm pin: glue into the wrist_pitch link, runs in the cover boss
  translate([0,0,-6.4]) cylinder(d=9,h=1.1);
  translate([0,0,-5.3]) cylinder(d=4.95,h=12.3);
}
