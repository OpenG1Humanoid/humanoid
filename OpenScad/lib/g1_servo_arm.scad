      translate([0,0,-7.0000]) cylinder(d=18.4752,h=7.6100,$fn=6);
      translate([0,0,0.6000]) cylinder(r=9.6376,h=3.0000);
    }
    translate([0,0,-8.0000]) cylinder(d=3.8000,h=12.6000);                 // horn centre screw (through)
    translate([0,0,-8.0000]) cylinder(d=6.4000,h=6.6000);               // its head sits on a 2 mm floor
    for (a=[45,135,225,315]) rotate([0,0,a]) translate([4.9300,0,-0.4000]) cylinder(d=2.5000,h=5);  // horn screws from the horn side
    translate([0,0,2.6000]) cylinder(d=14.8000,h=2);                      // 1 mm horn locating recess
    for (a=[30:60:330]) rotate([0,0,a]) translate([0,0,-4.0000]) rotate([0,90,0]) cylinder(d=2.5000,h=30);
  }
}
module hub_MG92B_wristroll() {   // print hex-end down. Torque via hex, radial screws hold the child.
